{
  "schema": "aoa_social_connector_manifest_v1",
  "connector_id": "aoa-youtube-connector",
  "provider": "youtube",
  "display_name": "YouTube",
  "version": "0.1.0-dev",
  "phase": "skeleton",
  "source_family": "social-network",
  "runtime_owner": "abyss-stack",
  "policy_snapshot_date": "2026-09-04",
  "official_docs": "https://developers.google.com/youtube/v3/",
  "planes": {
    "evidence": {
      "status": "planned",
      "effect": "read_only"
    },
    "draft": {
      "status": "planned",
      "effect": "none"
    },
    "publication_plan": {
      "status": "planned",
      "effect": "none"
    },
    "publication_commit": {
      "status": "disabled",
      "effect": "external_write",
      "requires_approval": true
    }
  },
  "capabilities": {
    "read": [
      "public_search",
      "channels",
      "videos",
      "playlists",
      "comments",
      "owned_captions",
      "owned_analytics"
    ],
    "publish": [
      "video",
      "short",
      "thumbnail",
      "caption_track",
      "scheduled_video"
    ],
    "deferred": [
      "community_post",
      "third_party_caption_download"
    ]
  },
  "policy": {
    "official_api_only": true,
    "scraping_enabled": false,
    "credentials_in_repo": false,
    "publication_default": "disabled"
  }
}
